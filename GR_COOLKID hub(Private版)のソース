do
    local CT = Tabs.Character
    local secM = CT:AddLeftGroupbox("Movement")
    local MS = {Walkspeed=false, WalkspeedValue=5, InfiniteJump=false, InfiniteJumpPower=100, Noclip=false, Connections={}}
    function MS.WalkspeedFunc()
        if MS.Connections.WS then MS.Connections.WS:Disconnect() end
        if MS.Walkspeed then
            MS.Connections.WS = R.Stepped:Connect(function()
                local p = L
                if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChildOfClass("Humanoid") and typeof(MS.WalkspeedValue)=="number" then
                    local h = p.Character.HumanoidRootPart
                    local u = p.Character:FindFirstChildOfClass("Humanoid")
                    h.CFrame = h.CFrame + u.MoveDirection * (16 * MS.WalkspeedValue / 10)
                end
            end)
        end
    end
    function MS.InfiniteJumpFunc()
        if MS.Connections.JP then MS.Connections.JP:Disconnect() end
        if MS.InfiniteJump then
            MS.Connections.JP = U.JumpRequest:Connect(function()
                if L and L.Character and L.Character:FindFirstChildOfClass("Humanoid") then
                    local Hum = L.Character:FindFirstChildOfClass("Humanoid")
                    Hum:ChangeState(Enum.HumanoidStateType.Freefall)
                    task.wait()
                    Hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    if Hum.UseJumpPower == false then
                        Hum.JumpHeight = math.clamp(MS.InfiniteJumpPower/10, 7.2, 50)
                    else
                        Hum.JumpPower = MS.InfiniteJumpPower
                    end
                end
            end)
        end
    end
    function MS.NoclipFunc()
        if MS.Connections.NC then MS.Connections.NC:Disconnect() end
        if MS.Noclip then
            MS.Connections.NC = R.Stepped:Connect(function()
                local p = L
                if p and p.Character then
                    for _, Part in ipairs(p.Character:GetDescendants()) do
                        if Part:IsA("BasePart") then Part.CanCollide = false end
                    end
                end
            end)
        end
    end
    secM:AddToggle("WS_T", {Text="Walkspeed", Default=false, Callback=function(State) MS.Walkspeed = State MS.WalkspeedFunc() end})
    secM:AddSlider("WS_V", {Text="Speed Multiplier", Min=1, Max=5, Default=0.1, Rounding=1, Callback=function(V) MS.WalkspeedValue = V end})
    secM:AddToggle("IJ_T", {Text="Infinite Jump", Default=false, Callback=function(State) MS.InfiniteJump = State MS.InfiniteJumpFunc() end})
    secM:AddSlider("IJ_P", {Text="Jump Power", Min=16, Max=500, Default=16, Rounding=0, Callback=function(V) MS.InfiniteJumpPower = V end})
    secM:AddToggle("NC_T", {Text="Noclip", Default=false, Callback=function(State) MS.Noclip = State MS.NoclipFunc() end})
end

