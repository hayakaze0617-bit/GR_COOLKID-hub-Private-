local function FWD(p, n, t) return p:FindFirstChild(n) or p:WaitForChild(n, t) end
local function CFP(p, n) return p:FindFirstChild(n) ~= nil end
local function Huge() return math.huge, math.huge, math.huge end
local function GetMag(a, b) return (a.Position - b.Position).Magnitude end
local function gDP(n)
    local t = {}
    for _, d in pairs(W:GetDescendants()) do
        if d:IsA("Part") and d.Name == n then table.insert(t, d) end
    end
    return t
end
local PHP = gDP("PoisonHurtPart")

local function iPW(pl)
    return wlE and pl and pcall(function() return L:IsFriendsWith(pl.UserId) end)
end

local function StopAllVelocity(parent)
    local t = parent.PrimaryPart or parent
    t.AssemblyLinearVelocity = Vector3.zero
    t.AssemblyAngularVelocity = Vector3.zero
end
local function StopVelocityF()
    if LC and LC:FindFirstChild("HumanoidRootPart") then
        LC.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
    end
end

local function FindBlob()
    local hum = LC and LC:FindFirstChild("Humanoid")
    if not hum then return nil end
    if etc.LastBlob == nil or not CFP(etc.LastBlob, "VehicleSeat") or etc.LastBlob.VehicleSeat.Occupant ~= hum then
        etc.LastBlob = hum.SeatPart and hum.SeatPart:FindFirstAncestor("CreatureBlobman")
    end
    return etc.LastBlob
end

local function CheckForHome()
    if etc.LastHouse == nil or etc.LastPlotOwner == nil or etc.LastPlotOwner.Parent == nil then
        for i = 1, 5 do
            local Plot = workspace.Plots["Plot"..i]
            for _, v in pairs(Plot.PlotSign["ThisPlotsOwners"]:GetChildren()) do
                if v.Value == L.Name then
                    etc.LastHouse = workspace.PlotItems["Plot"..i]
                    etc.LastPlotOwner = v
                    return etc.LastHouse
                end
            end
        end
    end
    return etc.LastHouse
end

local function SpawnToy(ToyName)
    if InPlot.Value and not InOwnedPlot.Value then
        InPlot:GetPropertyChangedSignal("Value"):Wait()
    end
    if not CanSpawnToy.Value then
        CanSpawnToy:GetPropertyChangedSignal("Value"):Wait()
    end
    local hrp = LC:FindFirstChild("HumanoidRootPart")
    local SpawnCF = (etc.MyPCLD or hrp).CFrame * CFrame.new(0, 14, 20)
    local Container = InOwnedPlot.Value and CheckForHome() or inv
    if not Container then return nil end
    local spawnedObject
    local connection = Container.ChildAdded:Connect(function(child)
        if child.Name == ToyName then spawnedObject = child end
    end)
    task.spawn(function() pcall(function() SpawnToyRemote:InvokeServer(ToyName, SpawnCF, Vector3.zero) end) end)
    local start = tick()
    repeat task.wait() until spawnedObject or (tick() - start) > 2.5
    if connection then connection:Disconnect() end
    return spawnedObject
end

local function RenameInShop(Instance, OriginalName, ToRename)
    local index
    local ToCheckName = Instance.Name or Instance
    for i, v in pairs(inv:GetChildren()) do if v.Name == ToCheckName then index = i end end
    if index == nil then return end
    local contents = L.PlayerGui.MenuGui.Menu.TabContents.ToyDestroy.Contents
    for i, v in ipairs(contents:GetChildren()) do
        if v.Name == OriginalName and i == index then
            local view = v.ViewItemButton
            view.Text = ToRename
            view.TextScaled = true
            view.LowResImage.Image = ""
        end
    end
end

