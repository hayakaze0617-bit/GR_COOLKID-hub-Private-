local function isGround(part)
    if not part then return false end
    return part:IsA("BasePart") or part:IsA("Terrain")
end

local function checkGroundBreak()
    local c = L.Character
    if not c then return false end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = {c}
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local result = W:Raycast(hrp.Position, Vector3.new(0, -10, 0), rp)
    if not result then return false end
    return isGround(result.Instance)
end

task.spawn(function()
    while true do
        if autoGroundBreakRunning then
            pcall(function() checkGroundBreak() task.wait(0.8) end)
        end
        task.wait(0.1)
    end
end)

